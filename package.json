{
  "name": "dragon-agent",
  "version": "0.7.0",
  "private": true,
  "description": "银白龙娘 · TypeScript 桌面 Agent 工作台",
  "main": "dist/main/index.cjs",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "electron .",
    "dev": "npm run build && npm start",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:ui": "node scripts/ui-check.mjs",
    "test:drop": "node scripts/drop-check.mjs",
    "test:civitai": "node scripts/civitai-key-check.mjs",
    "test:illustration-layout": "node scripts/illustration-layout-check.mjs",
    "test:illustration-agent": "tsx scripts/illustration-agent-check.mjs",
    "test:composer": "node scripts/composer-draft-check.mjs",
    "test:reasoning": "node scripts/reasoning-check.mjs",
    "test:context-bar": "node scripts/context-bar-check.mjs",
    "test:planning": "node scripts/planning-ui-check.mjs",
    "test:media": "tsx scripts/media-check.ts",
    "test:appearance": "node scripts/appearance-check.mjs",
    "test:comfy-live": "node scripts/comfy-live-check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "prepare:runtime": "tsx scripts/prepare-runtime.ts",
    "package": "npm run build && npm run prepare:runtime && node scripts/stage.mjs && npm ci --omit=dev --ignore-scripts --prefix .cache/package-app --cache .cache/npm && node scripts/package.mjs",
    "test:workbench": "node --import tsx scripts/workbench060-check.mjs",
    "test:queue": "node scripts/queue060-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/mcp": "0.0.83",
    "ajv": "8.20.0",
    "fflate": "0.8.3",
    "mammoth": "1.13.0",
    "pdf-parse": "2.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yazl": "^3.3.1",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "ws": "8.18.3"
  },
  "build": {
    "asar": false,
    "electronDist": "node_modules/electron/dist",
    "appId": "local.dragonagent.desktop",
    "productName": "DragonAgent",
    "directories": {
      "output": "release/0.6.0"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/**/*.node",
      "node_modules/playwright*/**/*",
      "node_modules/@playwright/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": true,
      "icon": "dist/assets/branding/dragon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DragonAgent-Setup-${version}.${ext}"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
